/* Сброс отступов */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: system-ui, -apple-system, Arial, sans-serif;
    background: #f4f6f9;
    color: #222;
    line-height: 1.5;
}

/* Верхняя навигация */
.navbar {
    background: #2c3e50;
    color: white;
    padding: 16px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.1);
}

.navbar .logo {
    font-size: 20px;
    font-weight: bold;
}

.navbar nav a {
    color: #ecf0f1;
    margin-left: 20px;
    text-decoration: none;
    font-size: 15px;
    transition: color .2s;
}

.navbar nav a:hover {
    color: #3498db;
}

/* Основной контейнер */
main {
    max-width: 960px;
    margin: 32px auto;
    padding: 0 16px;
}

h1 {
    font-size: 28px;
    margin-bottom: 20px;
}

h2 {
    font-size: 20px;
    margin-bottom: 12px;
}

/* Карточки */
.card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    margin-bottom: 20px;
}

/* Кнопки */
.btn {
    display: inline-block;
    background: #3498db;
    color: white;
    padding: 10px 22px;
    border-radius: 8px;
    text-decoration: none;
    border: none;
    font-size: 15px;
    cursor: pointer;
    transition: background .2s;
}

.btn:hover {
    background: #2980b9;
}

.btn-secondary {
    background: #95a5a6;
}

.btn-secondary:hover {
    background: #7f8c8d;
}

/* Формы авторизации */
.auth-container {
    max-width: 400px;
    margin: 80px auto;
    background: white;
    padding: 36px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
}

.auth-container h1 {
    text-align: center;
    margin-bottom: 24px;
}

.auth-container label {
    display: block;
    margin-top: 14px;
    font-size: 14px;
    color: #555;
}

.auth-container input {
    width: 100%;
    padding: 10px 12px;
    margin-top: 6px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 15px;
}

.auth-container input:focus {
    outline: none;
    border-color: #3498db;
}

.auth-container button {
    width: 100%;
    margin-top: 22px;
    padding: 12px;
    background: #3498db;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    transition: background .2s;
}

.auth-container button:hover {
    background: #2980b9;
}

.auth-container .links {
    text-align: center;
    margin-top: 18px;
    font-size: 14px;
}

.auth-container .links a {
    color: #3498db;
    text-decoration: none;
}

/* Сетка для карточек */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
}

/* Бейджи статусов */
.badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
}

.badge-green { background: #d4edda; color: #155724; }
.badge-yellow { background: #fff3cd; color: #856404; }
.badge-red { background: #f8d7da; color: #721c24; }

/* ===== Таблицы ===== */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
}

th, td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid #eaeaea;
}

th {
    background: #f8f9fb;
    font-weight: 600;
    color: #555;
    font-size: 14px;
}

tr:hover td {
    background: #fafbfc;
}

/* ===== Экзамены ===== */
.exam-card {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    border-left: 4px solid #3498db;
}

.exam-card h3 {
    margin-bottom: 8px;
    font-size: 18px;
}

.exam-card .meta {
    color: #666;
    font-size: 14px;
    margin: 4px 0;
}

/* ===== Прогресс-бар ===== */
.progress-bar {
    background: #eaeaea;
    border-radius: 10px;
    height: 12px;
    overflow: hidden;
    margin-top: 6px;
}

.progress-bar .fill {
    background: #3498db;
    height: 100%;
    border-radius: 10px;
    transition: width .4s;
}

.fill-green { background: #27ae60; }
.fill-yellow { background: #f39c12; }
.fill-red { background: #e74c3c; }

/* ===== Статистика ===== */
.stat-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
}

.stat-row:last-child {
    border-bottom: none;
}

/* ===== Разбор ошибок ===== */
.mistake {
    background: #fff8f8;
    border-left: 4px solid #e74c3c;
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 12px;
}

.mistake.correct {
    background: #f4fdf7;
    border-left-color: #27ae60;
}

.mistake strong {
    color: #333;
}

.mistake .topic {
    font-size: 13px;
    color: #888;
}

/* ===== Заголовки с отступами ===== */
.section-title {
    margin: 32px 0 16px;
    font-size: 22px;
}

/* ===== Адаптив для мобильных ===== */
@media (max-width: 600px) {
    .navbar {
        flex-direction: column;
        gap: 10px;
        padding: 14px 18px;
    }
    .navbar nav a {
        margin: 0 10px 0 0;
        font-size: 14px;
    }
    h1 { font-size: 22px; }
    th, td { padding: 8px 10px; font-size: 14px; }
}
